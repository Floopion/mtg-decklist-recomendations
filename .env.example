# Gemini API key (server-side only — never use NEXT_PUBLIC_ prefix)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model (optional, defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
# See: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# Upstash Redis (for rate limiting)
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Portfolio integration (set when deployed as an MFE zone)
NEXT_PUBLIC_BASE_PATH=/mtg-rag
NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio-six-pi-77.vercel.app
